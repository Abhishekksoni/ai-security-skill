{
  "name": "ai-security-skill",
  "version": "0.1.0",
  "description": "Open-source security control layer for AI coding agents.",
  "type": "module",
  "bin": {
    "ai-security-skill": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/core/engine.js",
      "types": "./dist/core/engine.d.ts"
    }
  },
  "files": [
    "dist",
    "rules",
    "controls",
    "knowledge",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx",
    "mcp": "tsx src/mcp/server.ts",
    "check": "npm run build && npm test",
    "benchmark": "tsx tests/benchmark/runner.ts",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "typescript": "^5.9.2",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.20.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhishekksoni/ai-security-skill.git"
  },
  "bugs": {
    "url": "https://github.com/Abhishekksoni/ai-security-skill/issues"
  },
  "homepage": "https://github.com/Abhishekksoni/ai-security-skill#readme",
  "license": "Apache-2.0"
}
